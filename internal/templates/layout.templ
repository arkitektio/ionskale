package templates

templ Index(version string, revision string) {
    <section class="stack stack-center hero">
        <span class="eyebrow">ionscale</span>
        <h1 class="title">Control plane online</h1>
        <p class="subtitle">Self-hosted tailnet coordination with a cleaner authentication surface.</p>
        <div class="metaGrid">
            <div class="metaCard">
                <span class="metaLabel">Version</span>
                <code>{ version }</code>
            </div>
            <div class="metaCard">
                <span class="metaLabel">Revision</span>
                <code>{ revision }</code>
            </div>
        </div>
    </section>
}

templ Success() {
    <section class="stack stack-center hero">
        <span class="eyebrow eyebrow-success">Authorized</span>
        <h1 class="title">Authorization successful</h1>
        <p class="subtitle">You can now close this window and return to your device.</p>
    </section>
}

templ NewMachine() {
    <section class="stack stack-center hero">
        <span class="eyebrow eyebrow-info">Authenticated</span>
        <h1 class="title">This machine still needs approval</h1>
        <p class="subtitle">Authentication succeeded, but this is a <span class="highlight highlight-info">new machine</span> and it still needs approval from your Tailnet admin.</p>
    </section>
}

templ Error() {
    <section class="stack stack-center hero">
        <span class="eyebrow eyebrow-danger">Error</span>
        <h1 class="title">Something went wrong</h1>
        <p class="subtitle">The request could not be completed. Retry the flow or inspect the server logs for more detail.</p>
    </section>
}

// denial is the shared shape of every "you signed in, but ..." screen: the
// sign-in itself worked, so the page leads with that and then explains the
// specific thing that stopped it, followed by the one action that resolves it.
templ denial(eyebrow string, title string, detail string, nextStep string) {
    <section class="stack stack-center hero">
        <span class="eyebrow eyebrow-danger">{ eyebrow }</span>
        <h1 class="title">{ title }</h1>
        <p class="subtitle">{ detail }</p>
        <div class="panel nextStep">
            <span class="panelLabel">What to do next</span>
            <p class="panelText">{ nextStep }</p>
        </div>
    </section>
}

templ Unauthorized() {
    @denial(
        "Access denied",
        "You are not authorized to use any network",
        "Your sign-in succeeded and your identity is valid, but it does not grant access to any network on this control plane.",
        "Ask an administrator of this control plane to grant your account access to a network.",
    )
}

templ NoNetworks() {
    @denial(
        "Access denied",
        "This control plane has no networks yet",
        "Your sign-in succeeded. Access was denied because no network exists on this server at all, so there is nothing yet for your account to join.",
        "An administrator needs to create a network on this control plane. Until one exists, every sign-in will end on this page.",
    )
}

templ NoNetworkForOrganization() {
    @denial(
        "Access denied",
        "No network belongs to your organization",
        "Your sign-in succeeded and your identity carries an organization, but no network on this server is bound to it. Networks are scoped to a single organization, so networks belonging to other organizations are never offered.",
        "Ask an administrator to create a network for your organization, or to confirm that your account is in the organization you expect.",
    )
}

templ OrganizationRequired() {
    @denial(
        "Access denied",
        "Your identity carries no organization",
        "Your sign-in succeeded, but this server scopes every network to an organization and your identity did not include one. Without an organization there is no network you are eligible to join.",
        "Ask an administrator to assign your account to an organization in the identity provider, so the organization claim is present the next time you sign in.",
    )
}

templ NotOnAccessPolicy() {
    @denial(
        "Access denied",
        "No network's access policy includes your account",
        "Your sign-in succeeded and networks do exist, but each one has an access policy, and none of them matches your account.",
        "Ask an administrator to add your account to the access policy of the network you need.",
    )
}

templ ProviderRejected() {
    @denial(
        "Sign-in failed",
        "The identity provider refused the sign-in",
        "The request never got as far as this server's access checks: your identity provider rejected it and sent back an error instead of a sign-in. A cancelled login, an expired attempt, or a misconfigured client all look like this.",
        "Try signing in again. If it keeps failing, an administrator can find the provider's exact message in this server's log.",
    )
}

templ InvalidAuthKey() {
    @denial(
        "Invalid auth key",
        "That auth key is not valid",
        "The key you entered was not recognised. Auth keys are single-use or time-limited, so a key that worked before may since have been used or expired.",
        "Check the key for typos, or ask an administrator to issue a fresh auth key.",
    )
}

templ NotTagOwner() {
    @denial(
        "Access denied",
        "You are not an owner of the requested tags",
        "Your sign-in succeeded, but this device asked for tags that your account is not listed as an owner of, so it cannot claim them.",
        "Ask an administrator to add your account to the tag owners in the network's access policy, or retry with tags you already own.",
    )
}

templ NotMachineOwner() {
    @denial(
        "Access denied",
        "You are not the owner of this machine",
        "Your sign-in succeeded, but this action can only be approved by the account that owns the machine, and that is not your account.",
        "Sign in as the account that registered this machine, or ask its owner to approve the request.",
    )
}

templ layout(contents templ.Component) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        @heading()
    </head>
    <body>
    <main class="page">
        <div class="ambient ambientOne"></div>
        <div class="ambient ambientTwo"></div>
        <div class="wrapper">
            <div class="brandBar">
                <div class="brandMark">I</div>
                <div>
                    <p class="brandName">ionscale</p>
                    <p class="brandHint">Authentication gateway</p>
                </div>
            </div>
            <div class="shell">
                @contents
            </div>
        </div>
    </main>
    </body>
    </html>
}

templ heading() {
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
        /* Palette mirrors kontrol's (kontrol/src/index.css): the same OKLCH
           tokens derived from --brand-hue, the same 0.625rem radius scale, the
           same neutrals. kontrol switches themes with a .dark class on <html>;
           these pages are server-rendered with no toggle, so they follow the
           operating system instead. Light is the :root default, as in kontrol. */
        :root {
            --brand-hue: 267.256;
            --brand-chroma: 0.19;

            --radius: 0.625rem;
            --radius-md: calc(var(--radius) - 2px);
            --radius-lg: var(--radius);
            --radius-xl: calc(var(--radius) + 4px);
            --radius-2xl: calc(var(--radius) + 8px);
            --radius-3xl: calc(var(--radius) + 12px);

            --background: oklch(0.97 0.004 var(--brand-hue));
            --foreground: oklch(0.21 0.01 var(--brand-hue));
            --card: oklch(0.96 0.005 var(--brand-hue));
            --muted: oklch(0.95 0.006 var(--brand-hue));
            --muted-foreground: oklch(0.55 0.02 var(--brand-hue));
            --border: oklch(0.87 0.008 var(--brand-hue) / 0.5);
            --input: oklch(0.87 0.008 var(--brand-hue) / 0.5);
            --primary: oklch(0.48 var(--brand-chroma) var(--brand-hue));
            --primary-foreground: oklch(0.98 0.01 var(--brand-hue));
            --ring: oklch(0.55 calc(var(--brand-chroma) * 0.6) var(--brand-hue));
            --destructive: oklch(0.577 0.245 27.325);
            --success: oklch(0.52 0.13 155);

            --brand-logo-light: oklch(0.6 calc(var(--brand-chroma) * 0.9) var(--brand-hue));
            --brand-logo-mid: oklch(0.52 var(--brand-chroma) var(--brand-hue));
            --brand-logo-dark: oklch(0.46 var(--brand-chroma) var(--brand-hue));

            --shadow: 0 24px 60px oklch(0.21 0.01 var(--brand-hue) / 0.10);
        }

        @media (prefers-color-scheme: dark) {
            :root {
                /* kontrol damps chroma by 0.84 on dark surfaces. */
                --brand-chroma: calc(0.19 * 0.84);

                --background: oklch(0.16 0.008 var(--brand-hue));
                --foreground: oklch(0.94 0.005 var(--brand-hue));
                --card: oklch(0.19 0.008 var(--brand-hue));
                --muted: oklch(0.22 0.008 var(--brand-hue));
                --muted-foreground: oklch(0.71 0.01 var(--brand-hue) / 0.85);
                --border: oklch(0.55 0.01 var(--brand-hue) / 0.2);
                --input: oklch(0.55 0.01 var(--brand-hue) / 0.2);
                --primary: oklch(0.70 var(--brand-chroma) var(--brand-hue));
                --primary-foreground: oklch(0.16 0.02 var(--brand-hue));
                --ring: oklch(0.60 calc(var(--brand-chroma) * 0.6) var(--brand-hue));
                --destructive: oklch(0.704 0.191 22.216);
                --success: oklch(0.72 0.15 155);

                --brand-logo-light: oklch(0.72 calc(var(--brand-chroma) * 0.9) var(--brand-hue));
                --brand-logo-mid: oklch(0.64 var(--brand-chroma) var(--brand-hue));
                --brand-logo-dark: oklch(0.56 var(--brand-chroma) var(--brand-hue));

                --shadow: 0 24px 60px oklch(0 0 0 / 0.5);
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            /* Tailwind's default sans stack, which is what kontrol renders in. */
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
                "Helvetica Neue", Arial, "Noto Sans", sans-serif;
        }

        body {
            min-height: 100vh;
            background: var(--background);
            color: var(--foreground);
            -webkit-font-smoothing: antialiased;
        }

        .page {
            position: relative;
            min-height: 100vh;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            overflow: hidden;
        }

        /* Echoes kontrol's brand wash behind the landing surface. */
        .ambient {
            position: absolute;
            border-radius: 999px;
            filter: blur(90px);
            opacity: 0.22;
            pointer-events: none;
        }

        .ambientOne {
            top: 4%;
            left: 6%;
            width: 320px;
            height: 320px;
            background: var(--brand-logo-light);
        }

        .ambientTwo {
            right: 8%;
            bottom: 6%;
            width: 360px;
            height: 360px;
            background: var(--brand-logo-dark);
        }

        .wrapper {
            width: 100%;
            max-width: 560px;
            position: relative;
            z-index: 1;
        }

        .brandBar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            padding: 0 4px;
        }

        .brandMark {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-xl);
            background: linear-gradient(135deg, var(--brand-logo-light), var(--brand-logo-dark));
            color: var(--primary-foreground);
            font-weight: 700;
            letter-spacing: 0.06em;
            box-shadow: 0 8px 20px oklch(0.48 var(--brand-chroma) var(--brand-hue) / 0.28);
        }

        .brandName {
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .brandHint {
            color: var(--muted-foreground);
            font-size: 0.82rem;
        }

        /* kontrol's card: flat surface, hairline border, generous radius. */
        .shell {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-3xl);
            padding: 28px;
            box-shadow: var(--shadow);
        }

        .stack {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .stack-center {
            text-align: center;
            align-items: center;
        }

        .hero {
            gap: 14px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 26px;
            padding: 0 10px;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: var(--muted);
            color: var(--muted-foreground);
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .eyebrow-success {
            color: var(--success);
            border-color: color-mix(in oklch, var(--success) 30%, transparent);
            background: color-mix(in oklch, var(--success) 10%, transparent);
        }

        .eyebrow-info {
            color: var(--primary);
            border-color: color-mix(in oklch, var(--primary) 30%, transparent);
            background: color-mix(in oklch, var(--primary) 10%, transparent);
        }

        .eyebrow-danger {
            color: var(--destructive);
            border-color: color-mix(in oklch, var(--destructive) 30%, transparent);
            background: color-mix(in oklch, var(--destructive) 10%, transparent);
        }

        .title {
            font-size: clamp(1.55rem, 3.4vw, 1.95rem);
            line-height: 1.15;
            font-weight: 600;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

        .subtitle {
            color: var(--muted-foreground);
            font-size: 0.95rem;
            line-height: 1.6;
            max-width: 46ch;
        }

        .highlight {
            font-weight: 600;
            color: var(--foreground);
        }

        .highlight-info {
            color: var(--primary);
        }

        .highlight-danger {
            color: var(--destructive);
        }

        .metaGrid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-top: 8px;
        }

        .metaCard {
            padding: 14px 16px;
            text-align: left;
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            background: var(--muted);
        }

        .metaLabel {
            display: block;
            margin-bottom: 8px;
            color: var(--muted-foreground);
            font-size: 0.72rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        code {
            color: var(--foreground);
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 0.85rem;
            word-break: break-word;
        }

        .sectionHeader {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sectionTitle {
            font-size: 1.3rem;
            font-weight: 600;
            line-height: 1.2;
            letter-spacing: -0.02em;
        }

        .sectionText {
            color: var(--muted-foreground);
            line-height: 1.6;
        }

        .divider {
            position: relative;
            text-align: center;
            color: var(--muted-foreground);
            font-size: 0.78rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .divider::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            border-top: 1px solid var(--border);
        }

        .divider span {
            position: relative;
            display: inline-block;
            padding: 0 12px;
            background: var(--card);
        }

        .form {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .label {
            color: var(--foreground);
            font-size: 0.88rem;
            font-weight: 500;
        }

        .helper {
            color: var(--muted-foreground);
            font-size: 0.88rem;
            line-height: 1.55;
        }

        .selectionList {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .selectionList li {
            list-style: none;
        }

        .selectionList li button {
            display: block;
            width: 100%;
            text-align: left;
        }

        input {
            display: block;
            width: 100%;
            min-height: 40px;
            padding: 0 12px;
            font: inherit;
            font-size: 0.92rem;
            border: 1px solid var(--input);
            border-radius: var(--radius-lg);
            background: var(--background);
            color: var(--foreground);
            outline: none;
            transition: border-color 120ms ease, box-shadow 120ms ease;
        }

        input::placeholder {
            color: var(--muted-foreground);
        }

        input:focus-visible {
            border-color: var(--ring);
            box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 35%, transparent);
        }

        button {
            width: 100%;
            min-height: 40px;
            padding: 10px 16px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            background: var(--background);
            color: var(--foreground);
            font: inherit;
            font-size: 0.92rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
        }

        button:hover {
            background: var(--muted);
        }

        button:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 35%, transparent);
        }

        .buttonPrimary {
            background: var(--primary);
            border-color: transparent;
            color: var(--primary-foreground);
        }

        .buttonPrimary:hover {
            background: color-mix(in oklch, var(--primary) 90%, var(--foreground));
        }

        .buttonRow {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .buttonLabel {
            display: block;
            font-weight: 500;
        }

        .buttonHint {
            display: block;
            margin-top: 4px;
            color: var(--muted-foreground);
            font-size: 0.82rem;
            font-weight: 400;
        }

        .buttonPrimary .buttonHint {
            color: color-mix(in oklch, var(--primary-foreground) 78%, transparent);
        }

        .panel {
            padding: 16px 18px;
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            background: var(--muted);
        }

        .panel strong {
            color: var(--foreground);
        }

        /* The "what to do next" block on the denial screens. Left-aligned even
           inside a centred hero: it is an instruction to follow, not a headline. */
        .nextStep {
            width: 100%;
            margin-top: 4px;
            text-align: left;
        }

        .panelLabel {
            display: block;
            margin-bottom: 6px;
            color: var(--muted-foreground);
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .panelText {
            color: var(--foreground);
            font-size: 0.92rem;
            line-height: 1.6;
        }

        @media (max-width: 640px) {
            .page {
                padding: 16px;
            }

            .shell {
                padding: 22px;
                border-radius: var(--radius-2xl);
            }

            .metaGrid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <title>ionscale</title>
}
