package templates

// toneIcon keeps the status glyphs inline: these pages are served standalone,
// with no asset pipeline to pull an icon set from.
templ toneIcon(tone string) {
	if tone == "success" {
		<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
	} else if tone == "danger" {
		<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
	} else {
		<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
	}
}

templ statusHead(tone string, title string, detail string) {
	<div class="head">
		<div class={ "mark mark-" + tone }>
			@toneIcon(tone)
		</div>
		<div>
			<h1 class="title">{ title }</h1>
			<p class="subtitle">{ detail }</p>
		</div>
	</div>
}

templ Index(version string, revision string) {
	<section class="stack">
		@statusHead("info", "Control plane online", "Self-hosted tailnet coordination.")
		<div class="metaGrid">
			<div class="metaCard">
				<span class="metaLabel">Version</span>
				<code>{ version }</code>
			</div>
			<div class="metaCard">
				<span class="metaLabel">Revision</span>
				<code>{ revision }</code>
			</div>
		</div>
	</section>
}

templ Success() {
	<section class="stack">
		@statusHead("success", "Authorization successful", "You can now close this window and return to your device.")
	</section>
}

templ NewMachine() {
	<section class="stack">
		@statusHead("info", "This machine needs approval", "Authentication succeeded, but this is a new machine and a tailnet admin still has to approve it.")
	</section>
}

templ Error() {
	<section class="stack">
		@statusHead("danger", "Something went wrong", "The request could not be completed. Retry the flow, or check the server logs for detail.")
	</section>
}

// denial is the shared shape of every "you signed in, but ..." screen: what
// stopped it, then the one action that resolves it.
templ denial(title string, detail string, nextStep string) {
	<section class="stack">
		@statusHead("danger", title, detail)
		<hr class="separator"/>
		<div>
			<span class="nextLabel">What to do next</span>
			<p class="nextText">{ nextStep }</p>
		</div>
	</section>
}

templ Unauthorized() {
    @denial(
        "You are not authorized to use any network",
        "Your sign-in succeeded and your identity is valid, but it does not grant access to any network on this control plane.",
        "Ask an administrator of this control plane to grant your account access to a network.",
    )
}

templ NoNetworks() {
    @denial(
        "This control plane has no networks yet",
        "Your sign-in succeeded. Access was denied because no network exists on this server at all, so there is nothing yet for your account to join.",
        "An administrator needs to create a network on this control plane. Until one exists, every sign-in will end on this page.",
    )
}

templ NoNetworkForOrganization() {
    @denial(
        "No network belongs to your organization",
        "Your sign-in succeeded and your identity carries an organization, but no network on this server is bound to it. Networks are scoped to a single organization, so networks belonging to other organizations are never offered.",
        "Ask an administrator to create a network for your organization, or to confirm that your account is in the organization you expect.",
    )
}

templ OrganizationRequired() {
    @denial(
        "Your identity carries no organization",
        "Your sign-in succeeded, but this server scopes every network to an organization and your identity did not include one. Without an organization there is no network you are eligible to join.",
        "Ask an administrator to assign your account to an organization in the identity provider, so the organization claim is present the next time you sign in.",
    )
}

templ NotOnAccessPolicy() {
    @denial(
        "No network's access policy includes your account",
        "Your sign-in succeeded and networks do exist, but each one has an access policy, and none of them matches your account.",
        "Ask an administrator to add your account to the access policy of the network you need.",
    )
}

templ ProviderRejected() {
    @denial(
        "The identity provider refused the sign-in",
        "The request never got as far as this server's access checks: your identity provider rejected it and sent back an error instead of a sign-in. A cancelled login, an expired attempt, or a misconfigured client all look like this.",
        "Try signing in again. If it keeps failing, an administrator can find the provider's exact message in this server's log.",
    )
}

templ InvalidAuthKey() {
    @denial(
        "That auth key is not valid",
        "The key you entered was not recognised. Auth keys are single-use or time-limited, so a key that worked before may since have been used or expired.",
        "Check the key for typos, or ask an administrator to issue a fresh auth key.",
    )
}

templ NotTagOwner() {
    @denial(
        "You are not an owner of the requested tags",
        "Your sign-in succeeded, but this device asked for tags that your account is not listed as an owner of, so it cannot claim them.",
        "Ask an administrator to add your account to the tag owners in the network's access policy, or retry with tags you already own.",
    )
}

templ NotMachineOwner() {
    @denial(
        "You are not the owner of this machine",
        "Your sign-in succeeded, but this action can only be approved by the account that owns the machine, and that is not your account.",
        "Sign in as the account that registered this machine, or ask its owner to approve the request.",
    )
}

templ layout(contents templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		@heading()
	</head>
	<body>
	<main class="page">
		<div class="wrapper">
			<p class="brand">ionscale</p>
			<div class="shell">
				@contents
			</div>
		</div>
	</main>
	</body>
	</html>
}

templ heading() {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<style>
        /* Palette and scale mirror kontrol (kontrol/src/index.css): the same
           OKLCH tokens derived from --brand-hue, the same 0.625rem radius
           scale, the same neutrals. kontrol switches themes with a .dark class
           on <html>; these pages are server-rendered with no toggle, so they
           follow the operating system instead. Light is the :root default, as
           in kontrol.

           Kept deliberately plain: kontrol's own surfaces are a flat card with
           a hairline border and shadow-sm, a muted icon square, a 1.5rem
           title and small muted body text. No gradients, no ambient wash, no
           status pills -- the icon and the title carry the state. */
        :root {
            --brand-hue: 267.256;
            --brand-chroma: 0.19;

            --radius: 0.625rem;
            --radius-lg: var(--radius);
            --radius-xl: calc(var(--radius) + 4px);

            --background: oklch(0.97 0.004 var(--brand-hue));
            --foreground: oklch(0.21 0.01 var(--brand-hue));
            --card: oklch(0.96 0.005 var(--brand-hue));
            --muted: oklch(0.95 0.006 var(--brand-hue));
            --muted-foreground: oklch(0.55 0.02 var(--brand-hue));
            --border: oklch(0.87 0.008 var(--brand-hue) / 0.5);
            --primary: oklch(0.48 var(--brand-chroma) var(--brand-hue));
            --primary-foreground: oklch(0.98 0.01 var(--brand-hue));
            --ring: oklch(0.55 calc(var(--brand-chroma) * 0.6) var(--brand-hue));
            --destructive: oklch(0.577 0.245 27.325);
            --success: oklch(0.52 0.13 155);
            /* kontrol's Card: shadow-sm, not a lifted panel. */
            --shadow: 0 1px 2px 0 oklch(0.21 0.01 var(--brand-hue) / 0.05);
        }

        @media (prefers-color-scheme: dark) {
            :root {
                /* kontrol damps chroma by 0.84 on dark surfaces. */
                --brand-chroma: calc(0.19 * 0.84);

                --background: oklch(0.16 0.008 var(--brand-hue));
                --foreground: oklch(0.94 0.005 var(--brand-hue));
                --card: oklch(0.19 0.008 var(--brand-hue));
                --muted: oklch(0.22 0.008 var(--brand-hue));
                --muted-foreground: oklch(0.71 0.01 var(--brand-hue) / 0.85);
                --border: oklch(0.55 0.01 var(--brand-hue) / 0.2);
                --primary: oklch(0.70 var(--brand-chroma) var(--brand-hue));
                --primary-foreground: oklch(0.16 0.02 var(--brand-hue));
                --ring: oklch(0.60 calc(var(--brand-chroma) * 0.6) var(--brand-hue));
                --destructive: oklch(0.704 0.191 22.216);
                --success: oklch(0.72 0.15 155);
                --shadow: 0 1px 2px 0 oklch(0 0 0 / 0.3);
            }
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html {
            /* Tailwind's default sans stack, which is what kontrol renders in. */
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
                "Helvetica Neue", Arial, "Noto Sans", sans-serif;
        }

        body {
            min-height: 100vh;
            background: var(--background);
            color: var(--foreground);
            -webkit-font-smoothing: antialiased;
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .wrapper { width: 100%; max-width: 480px; }

        .brand {
            margin: 0 0 10px 2px;
            color: var(--muted-foreground);
            font-size: 0.8rem;
            font-weight: 500;
        }

        /* kontrol's Card: rounded-xl, hairline border, shadow-sm, py-6/px-6. */
        .shell {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 24px;
            box-shadow: var(--shadow);
        }

        /* kontrol stacks card content with gap-6. */
        .stack { display: flex; flex-direction: column; gap: 24px; }

        /* kontrol's PageHeader: a muted icon square beside the text. */
        .head { display: flex; align-items: flex-start; gap: 16px; }

        .mark {
            flex: 0 0 auto;
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-lg);
            background: var(--muted);
            color: var(--muted-foreground);
        }

        .mark-danger { color: var(--destructive); }
        .mark-success { color: var(--success); }
        .mark-info { color: var(--primary); }

        .icon { width: 22px; height: 22px; }

        .title {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            line-height: 1.2;
            text-wrap: balance;
        }

        .subtitle {
            margin-top: 6px;
            color: var(--muted-foreground);
            font-size: 0.875rem;
            line-height: 1.6;
        }

        .separator { border: 0; border-top: 1px solid var(--border); }

        /* kontrol labels its sections in small uppercase muted text. */
        .nextLabel {
            display: block;
            margin-bottom: 6px;
            color: var(--muted-foreground);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .nextText { font-size: 0.875rem; line-height: 1.6; }

        .metaGrid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .metaCard {
            padding: 12px 14px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
        }

        .metaLabel {
            display: block;
            margin-bottom: 6px;
            color: var(--muted-foreground);
            font-size: 0.72rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 0.82rem;
            word-break: break-word;
        }

        /* --- shared with auth.templ / tailnets.templ --- */

        .sectionHeader { display: flex; flex-direction: column; gap: 6px; }
        .sectionTitle { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.015em; }
        .sectionText { color: var(--muted-foreground); font-size: 0.875rem; line-height: 1.6; }

        .eyebrow {
            display: inline-block;
            color: var(--muted-foreground);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .divider {
            position: relative;
            text-align: center;
            color: var(--muted-foreground);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .divider::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            border-top: 1px solid var(--border);
        }

        .divider span { position: relative; display: inline-block; padding: 0 10px; background: var(--card); }

        .form { display: flex; flex-direction: column; gap: 14px; }
        .field { display: flex; flex-direction: column; gap: 6px; }
        .label { font-size: 0.875rem; font-weight: 500; }
        .helper { color: var(--muted-foreground); font-size: 0.82rem; line-height: 1.55; }

        .selectionList { display: flex; flex-direction: column; gap: 8px; }
        .selectionList li { list-style: none; }
        .selectionList li button { display: block; width: 100%; text-align: left; }

        input {
            width: 100%;
            min-height: 36px;
            padding: 0 12px;
            font: inherit;
            font-size: 0.875rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--background);
            color: var(--foreground);
            outline: none;
        }

        input::placeholder { color: var(--muted-foreground); }

        input:focus-visible {
            border-color: var(--ring);
            box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 30%, transparent);
        }

        button {
            width: 100%;
            min-height: 36px;
            padding: 8px 14px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            background: transparent;
            color: var(--foreground);
            font: inherit;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 120ms ease;
        }

        button:hover { background: var(--muted); }

        button:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 30%, transparent);
        }

        .buttonPrimary { background: var(--primary); border-color: transparent; color: var(--primary-foreground); }
        .buttonPrimary:hover { background: color-mix(in oklch, var(--primary) 90%, var(--foreground)); }

        .buttonRow { display: flex; flex-direction: column; gap: 8px; }
        .buttonLabel { display: block; font-weight: 500; }
        .buttonHint { display: block; margin-top: 2px; color: var(--muted-foreground); font-size: 0.8rem; font-weight: 400; }
        .buttonPrimary .buttonHint { color: color-mix(in oklch, var(--primary-foreground) 78%, transparent); }

        .panel { padding: 14px 16px; border-radius: var(--radius-lg); border: 1px solid var(--border); }
        .panel strong { font-weight: 600; }

        @media (max-width: 640px) {
            .page { padding: 16px; }
            .shell { padding: 20px; }
            .metaGrid { grid-template-columns: 1fr; }
            .head { gap: 12px; }
        }
	</style>
	<title>ionscale</title>
}
